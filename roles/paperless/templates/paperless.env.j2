# Managed by Ansible — do not edit manually
# App: paperless-ngx | Host: VM-130 docs1 | Image: {{ paperless_app_version }}
#
# CONTAINS SECRETS — mode 0600. The task that writes this file carries
# no_log: true. Never run this playbook with -vvv: verbose mode renders
# template content into the log, and Semaphore persists task logs.

PAPERLESS_SECRET_KEY={{ _paperless_secret_key }}

# Broker. Container-network DNS: the name resolves to the ContainerName.
# valkey speaks the redis wire protocol, so the redis:// scheme is correct.
PAPERLESS_REDIS=redis://paperless-broker:{{ paperless_broker_port }}

# Required — seeds CSRF_TRUSTED_ORIGINS, without which logins fail behind
# Traefik. It does NOT restrict the Host header on its own.
PAPERLESS_URL={{ paperless_url }}
# This is what actually restricts the Host header. Without it, ALLOWED_HOSTS
# stays ['*'] and Django rejects nothing.
PAPERLESS_ALLOWED_HOSTS={{ paperless_allowed_hosts }}
# granian defaults to binding '::'; docs1.bu disables IPv6 on ens18.
PAPERLESS_BIND_ADDR=0.0.0.0

PAPERLESS_TIME_ZONE={{ paperless_time_zone }}

# SINGULAR — see defaults/main.yml. Never set the plural form.
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_language }}

PAPERLESS_TASK_WORKERS={{ paperless_task_workers }}
PAPERLESS_THREADS_PER_WORKER={{ paperless_threads_per_worker }}
PAPERLESS_WEBSERVER_WORKERS={{ paperless_webserver_workers }}

# ⚠️ _INTERVAL suffix is load-bearing. PAPERLESS_CONSUMER_POLLING does not
# exist in 3.0.5; setting it leaves the interval at 0, i.e. inotify, which is
# unreliable over NFS and fails silently.
PAPERLESS_CONSUMER_POLLING_INTERVAL={{ paperless_consumer_polling_interval }}
PAPERLESS_CONSUMER_STABILITY_DELAY={{ paperless_consumer_stability_delay }}

# Tika and Gotenberg are enabled as a unit — all three of these must be set
# together or Office and .eml handling silently does not happen.
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_ENDPOINT=http://paperless-tika:{{ paperless_tika_port }}
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://paperless-gotenberg:{{ paperless_gotenberg_port }}

# Off by default in 3.0.5, set explicitly anyway. A privileged corpus must not
# depend on an upstream default holding across versions. Turning this on would
# be a decision, on the record, to send privileged document text to an
# inference endpoint.
PAPERLESS_AI_ENABLED=NO

# Explicit rather than inherited, so the storage split is visible here as well
# as in the Volume= lines. data/ is LOCAL (SQLite + tantivy index + llm_index);
# media/, export/ and consume/ are NFS.
PAPERLESS_DATA_DIR=/usr/src/paperless/data
PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
PAPERLESS_CONSUMPTION_DIR=/usr/src/paperless/consume
