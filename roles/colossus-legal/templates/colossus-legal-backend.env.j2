# Managed by Ansible — do not edit manually
# Contains secrets — file permissions should be 0600

NEO4J_URI={{ colossus_legal_neo4j_uri }}
NEO4J_USER={{ colossus_legal_neo4j_user }}
NEO4J_PASSWORD={{ _neo4j_password }}
DATABASE_URL={{ _pg_url }}
PIPELINE_DATABASE_URL={{ _pg_url_v2 }}
ANTHROPIC_API_KEY={{ _anthropic_api_key }}
ANTHROPIC_MODEL={{ colossus_legal_anthropic_model }}
QDRANT_URL={{ colossus_legal_qdrant_url }}
FASTEMBED_CACHE_PATH={{ colossus_legal_fastembed_cache_path }}
DOCUMENT_STORAGE_PATH={{ colossus_legal_documents_container_path }}
PIPELINE_REGISTRY_FILE={{ colossus_legal_documents_container_path }}/config/pipeline_registry.yaml
# Legacy directory env vars — fallback when PIPELINE_REGISTRY_FILE is not set.
# Remove after registry is validated on DEV and PROD.
EXTRACTION_TEMPLATE_DIR={{ colossus_legal_documents_container_path }}/extraction_templates
EXTRACTION_SCHEMA_DIR={{ colossus_legal_documents_container_path }}/extraction_schemas
PROCESSING_PROFILE_DIR={{ colossus_legal_documents_container_path }}/profiles
SYSTEM_PROMPT_DIR={{ colossus_legal_documents_container_path }}/system_prompts
SURYA_OCR_URL=http://10.10.0.99:8340
RUST_LOG={{ colossus_legal_rust_log }}
CORS_ALLOWED_ORIGINS={{ colossus_legal_cors_origins }}
AUTH_MODE=required
AUTH_LOGOUT_URL={{ colossus_legal_auth_logout_url }}
COLOSSUS_ENVIRONMENT={{ 'dev' if 'dev' in group_names else 'prod' }}
CASE_DEFAULT_SUBJECT_NAME={{ colossus_legal_case_default_subject_name | default('Marie Awad') }}
CASE_SLUG={{ colossus_legal_case_slug }}

# LLM_MODEL is read by the v2 pipeline's colossus_extract factory
# (separate from ANTHROPIC_MODEL which is read by the legacy RAG path).
# Both point at the same colossus_legal_anthropic_model value —
# same model, two consumers.
LLM_MODEL={{ colossus_legal_anthropic_model }}

EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=NomicEmbedTextV15

# Restate SDK endpoint — port the backend listens on for Restate callbacks.
# Restate admin registers this backend at http://<host>:9080/restate.
# Must match the PublishPort=9080:9080 entry in the backend Quadlet file.
RESTATE_LISTEN_PORT={{ colossus_legal_restate_port }}

# Restate admin API URL — backend's dual-cancel handler calls this to
# cancel in-flight Restate workflow invocations. Read as Option<String>:
# when unset, the Restate cancel path silently skips.
RESTATE_ADMIN_URL={{ colossus_legal_restate_admin_url }}

# Restate ingress URL — backend submits new workflow invocations here
# (port 8080 on the Restate node).
RESTATE_INGRESS_URL={{ colossus_legal_restate_ingress_url }}

# Restate pipeline timeouts (seconds) — inactivity triggers a graceful
# cancellation; abort is the hard ceiling after which Restate kills the
# invocation outright.
PIPELINE_INACTIVITY_TIMEOUT_SECS={{ colossus_legal_pipeline_inactivity_timeout_secs }}
PIPELINE_ABORT_TIMEOUT_SECS={{ colossus_legal_pipeline_abort_timeout_secs }}

# Decomposer model — separate model used to break complex questions
# into sub-questions before retrieval (distinct from ANTHROPIC_MODEL).
DECOMPOSER_MODEL={{ colossus_legal_decomposer_model }}

# Theme Scan judge — the model the scan's relevance judge runs on, kept
# separate from ANTHROPIC_MODEL so tuning chat cannot silently alter scan
# judgments. Read as Option<String> (colossus-legal config.rs:599): unset
# means "fall back to the chat default", which is a billed Claude row.
#
# The value is the `llm_models.id`, not a display name — it must match the
# row exactly or the scan picker cannot resolve it. This one is the
# self-hosted Qwen on gpu1, seeded by pipeline migration
# 20260910105358_qwen27b_scan_model.sql, so a full scan costs nothing.
#
# A literal rather than a variable, like SURYA_OCR_URL and FASTEMBED_MODEL
# above: gpu1 is one machine serving both environments, so this value does
# not differ between DEV and PROD. Give it a group_vars variable on the day
# it needs to.
THEME_SCAN_MODEL=unsloth/Qwen3.8-27B-NVFP4

# Path inside the container where prompt templates live.
PROMPTS_DIR={{ colossus_legal_prompts_dir }}